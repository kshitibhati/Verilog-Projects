module demux1to4(
     wr_data,
     wr_sel,
    a,b,c,d,wr_enb,reset,
   clk);

    input [3:0] wr_data;
    output [1:0] wr_sel;
    input wr_enb, clk, reset;
    output reg[3:0] a,b,c,d;
reg [1:0] count;
reg [1:0] temp;

always @ (posedge clk)
if (rst)
temp = 0;
else if (temp== 2'b3)
count=count+1;
else if (count==2'b3)
count=0;

assign count = sel;
always @(wr_data or wr_sel)
    begin
        case (wr_sel)  
         
            2'b00 :a = wr_data[0]; 
                       
            2'b01 :b = wr_data[1];
                       
            2'b10 : c = wr_data[2];
                        
            2'b11 : d = wr_data[3];
        endcase

