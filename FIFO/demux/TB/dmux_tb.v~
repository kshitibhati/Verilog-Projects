module tb_demux;

    
    reg [3:0] wr_data;
    wire [1:0] wr_sel;
    reg wr_enb, reset,clk;

    
    wire a,b,c,d;

    
    demux1to4 uut (
        .wr_data(wr_data),.wr_enb(wr_enb),.reset(reset),
        .wr_sel(wr_sel), 
        .a(a),.b(b),.c(c),.d(d),.clk(clk));
		  
		  initial begin
		  clk = 0;
		  forever
		  #5 clk = !clk;
		  end
  

    initial begin
        reset = 1; wr_enb = 0; #10;
		  reset = 0; wr_enb = 1; #10;
	     wr_data = 4'b0010; #10;
		  reset = 0; wr_enb = 1; #10;
		  wr_data = 4'b1000; #10;
		  $finish;
   
	 end
    endmodule
