module digital_clk (clk,reset,seconds,minutes,hours);
    input clk,reset;
    output [5:0] seconds;
    output [5:0] minutes;
    output [4:0] hours;

    reg [5:0] seconds;
    reg [5:0] minutes;
    reg [4:0] hours;
    reg [3:0] temp_a;	 

  
 always @ (posedge clk )begin
        if(reset == 1) begin  
            
        seconds = 0;
        minutes = 0;
        hours = 0; 
		  temp_a =0;
       end
       else begin  
       temp_a = temp_a+1;
		 
		 end
		 
		 if (temp_a == 4'b1010)begin
		 temp_a = 0;
	    seconds = seconds +1;
		
		 if ( seconds == 6'd60)begin

		  seconds = 0;
        minutes = minutes + 1;

        if(minutes == 6'd60)
 begin 
		  minutes = 0;
        hours = hours + 1; 
		  
       if(hours ==  5'd24) 
begin 
        hours = 0;
end     
 end  
end
end
end
 
endmodule

