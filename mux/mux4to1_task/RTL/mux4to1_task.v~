module mux4to1 (i,sel,f);

input [3:0] i;
input [1:0] sel;
output reg  f;
wire [0:3] w;


always @ (i,sel)
begin
case (sel)
2'b00 : f = 1'b0;
2'b01 : f = 1'b1;
2'b10 : f = 1'b1;
2'b11 : f = 1'b0;
endcase
end

task mux ( input [1:0] sel,input [3:0]i, output f);

case (sel)
2'b00 : f = i[0];
2'b01 : f = i[1];
2'b10 : f = i[2];
2'b11 : f = i[3];

endcase
endtask
always @(*)
mux (s,i,f);
endmodule



endmodule
